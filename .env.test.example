# Copy to .env.test (gitignored). Used by ALL services via ENV_FILE=/abs/path/.env.test
# Values come from `supabase status` after `supabase start`. NEVER put production keys here.
APP_ENV=test                                   # enforces local-only Supabase/ML URLs in every service
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=                          # "service_role key" from `supabase status`

# FastAPI / ML
MODEL_PATH=artifacts/model_test.joblib         # separate from production artifacts/model.joblib
ML_ADMIN_KEY=test-ml-admin
MIN_TRAIN_ROWS=300

# Express
PORT=5000
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=8000
CORS_ORIGINS=http://localhost:5173
ADMIN_API_KEY=test-admin

# Scraper
HEADLESS=true                                  # false = watch the browser
MIN_DELAY=2
MAX_DELAY=5
SOURCE_TIMEZONE=UTC

# Frontend (not included here): VITE_API_URL=http://localhost:5000
